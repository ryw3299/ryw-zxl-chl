# Provider 配置文件模板
# 复制为 <provider_name>.env 并填入实际值后使用
#
# 用法: AgentFactory.create_agent(provider="<provider_name>", ...)

ANTHROPIC_BASE_URL=https://<your-provider-domain>/v1
ANTHROPIC_AUTH_TOKEN=sk-your-api-key-here
ANTHROPIC_API_KEY=sk-your-api-key-here
ANTHROPIC_MODEL=your-model-name
ANTHROPIC_SMALL_FAST_MODEL=your-model-name
ANTHROPIC_DEFAULT_SONNET_MODEL=your-model-name
ANTHROPIC_DEFAULT_OPUS_MODEL=your-model-name
API_TIMEOUT_MS=3000000
