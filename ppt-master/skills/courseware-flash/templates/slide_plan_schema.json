{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CoursewareFlashSlidePlan",
  "type": "object",
  "required": ["deck_title", "audience", "language", "slide_count", "slides"],
  "properties": {
    "deck_title": {
      "type": "string",
      "description": "Course title, shown on title slide and footer."
    },
    "audience": {
      "type": "string",
      "description": "Target learners, e.g. 'undergraduate engineering'."
    },
    "language": {
      "type": "string",
      "enum": ["zh", "en", "zh-en"],
      "description": "Primary language of the deck."
    },
    "slide_count": {
      "type": "integer",
      "minimum": 1,
      "description": "Total number of slides. Must match slides array length."
    },
    "global_style": {
      "type": "object",
      "description": "Optional overrides for colors/typography. If absent, renderer uses built-in global_style.json."
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide_id", "slug", "filename", "type", "rhythm", "title"],
        "properties": {
          "slide_id": {
            "type": "integer",
            "minimum": 1,
            "description": "1-based slide index."
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "description": "URL-safe identifier used in SVG stem."
          },
          "filename": {
            "type": "string",
            "pattern": "^\\d{2}_[a-z0-9_]+\\.svg$",
            "description": "SVG output filename, e.g. '01_title_slide.svg'."
          },
          "type": {
            "type": "string",
            "enum": ["title_slide", "chapter_transition", "lesson_objectives", "concept_explanation", "comparison", "classroom_question", "summary_slide"],
            "description": "Slide template type. Must match a Jinja2 template under svgj2/."
          },
          "rhythm": {
            "type": "string",
            "enum": ["anchor", "dense", "breathing"],
            "description": "Layout density hint."
          },
          "title": {
            "type": "string",
            "description": "Main heading for the slide."
          },
          "subtitle": {
            "type": "string",
            "description": "Optional subheading."
          },
          "bullets": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["text"],
              "properties": {
                "text": { "type": "string" },
                "sub": { "type": "string", "description": "Optional second-line detail." }
              }
            },
            "description": "Content points. Max 4 to keep teaching slides readable."
          },
          "teaching_goal": {
            "type": "string",
            "description": "One-sentence note summarising what this slide teaches. Used for notes/total.md."
          }
        }
      }
    }
  }
}
