<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1280 720" width="1280" height="720">
    <defs>
        <linearGradient id="hubGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="{{ colors.primary }}"/>
            <stop offset="100%" stop-color="{{ colors.secondary_accent }}"/>
        </linearGradient>
        <filter id="objCardShadow" x="-10%" y="-10%" width="120%" height="120%">
            <feGaussianBlur in="SourceAlpha" stdDeviation="5"/>
            <feOffset dx="0" dy="2" result="offsetblur"/>
            <feFlood flood-color="#1F2937" flood-opacity="0.08" result="shadowColor"/>
            <feComposite in="shadowColor" in2="offsetblur" operator="in" result="shadow"/>
            <feMerge><feMergeNode in="shadow"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
    </defs>

    <rect width="1280" height="720" fill="{{ colors.bg }}"/>
    <rect x="0" y="0" width="1280" height="120" fill="{{ colors.info_bg }}"/>
    <rect x="0" y="120" width="1280" height="2" fill="{{ colors.border }}"/>

    <g id="page-header">
        <rect x="60" y="44" width="6" height="32" fill="{{ colors.primary }}"/>
        <text x="80" y="68" font-family="{{ typography.body_family }}" font-size="14" font-weight="600" fill="{{ colors.text_secondary }}" letter-spacing="3">学习目标</text>
        <text x="60" y="106" font-family="{{ typography.title_family }}" font-size="34" font-weight="700" fill="{{ colors.text }}">{{ title }}</text>
    </g>

    <g id="hub-center">
        <circle cx="320" cy="420" r="135" fill="{{ colors.info_bg }}" stroke="{{ colors.border }}" stroke-width="1.5"/>
        <circle cx="320" cy="420" r="110" fill="url(#hubGrad)"/>
        <text x="320" y="402" text-anchor="middle" font-family="{{ typography.body_family }}" font-size="20" font-weight="500" fill="#FFFFFF" fill-opacity="0.78">本章</text>
        <text x="320" y="436" text-anchor="middle" font-family="{{ typography.body_family }}" font-size="32" font-weight="700" fill="#FFFFFF">学习目标</text>
        <use data-icon="tabler-filled/bulb" x="296" y="450" width="48" height="48" fill="{{ colors.accent }}"/>
    </g>

    {% for bullet in bullets %}
    {% set connectors = [(430, 362, 600, 240), (450, 420, 600, 420), (430, 478, 600, 600)] %}
    {% set cy = 180 + loop.index0 * 120 %}
    {% set cx = 612 %}
    {% if loop.index <= 3 %}
        {% set conn = connectors[loop.index0] %}
        <line x1="{{ conn[0] }}" y1="{{ conn[1] }}" x2="{{ conn[2] }}" y2="{{ conn[3] }}" stroke="{{ colors.primary }}" stroke-width="2.5" stroke-dasharray="4,4"/>
        <circle cx="{{ conn[2] }}" cy="{{ conn[3] }}" r="6" fill="{{ colors.primary }}"/>
    {% endif %}
    <g filter="url(#objCardShadow)">
        <rect x="612" y="{{ cy }}" width="608" height="100" rx="12" fill="{{ colors.bg }}" stroke="{{ colors.primary }}" stroke-width="1.5"/>
        <rect x="612" y="{{ cy }}" width="6" height="100" fill="{{ colors.primary }}"/>
        <rect x="636" y="{{ cy + 20 }}" width="58" height="26" rx="13" fill="{{ colors.primary }}"/>
        <text x="665" y="{{ cy + 38 }}" text-anchor="middle" font-family="{{ typography.body_family }}" font-size="14" font-weight="700" fill="#FFFFFF">0{{ loop.index }}</text>
        <text x="708" y="{{ cy + 38 }}" font-family="{{ typography.body_family }}" font-size="22" font-weight="700" fill="{{ colors.text }}">{{ bullet.text }}</text>
        {% if bullet.sub %}
        <text x="636" y="{{ cy + 72 }}" font-family="{{ typography.body_family }}" font-size="16" fill="{{ colors.text_secondary }}">{{ bullet.sub }}</text>
        {% endif %}
    </g>
    {% endfor %}

    <g id="objectives-list">
        <rect x="60" y="160" width="448" height="42" rx="6" fill="{{ colors.panel_yellow }}"/>
        <use data-icon="tabler-filled/bulb" x="74" y="167" width="28" height="28" fill="{{ colors.accent }}"/>
        <text x="112" y="187" font-family="{{ typography.body_family }}" font-size="16" font-weight="600" fill="{{ colors.text }}">学完本章后，你将能够 ——</text>
    </g>

    <text x="60" y="690" font-family="{{ typography.body_family }}" font-size="12" fill="{{ colors.text_secondary }}" letter-spacing="1">{{ deck_title }}　·　学习目标</text>
    <text x="1220" y="690" text-anchor="end" font-family="{{ typography.emphasis_family }}" font-size="12" fill="{{ colors.text_secondary }}" letter-spacing="2">{{ '%02d' % slide_id }} / {{ slide_count }}</text>
</svg>
