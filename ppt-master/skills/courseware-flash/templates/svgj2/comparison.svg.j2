<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1280 720" width="1280" height="720">
    <defs>
        <filter id="compCardShadow" x="-10%" y="-10%" width="120%" height="120%">
            <feGaussianBlur in="SourceAlpha" stdDeviation="5"/>
            <feOffset dx="0" dy="2" result="offsetblur"/>
            <feFlood flood-color="#1F2937" flood-opacity="0.08" result="shadowColor"/>
            <feComposite in="shadowColor" in2="offsetblur" operator="in" result="shadow"/>
            <feMerge><feMergeNode in="shadow"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
    </defs>

    <rect width="1280" height="720" fill="{{ colors.bg }}"/>

    <g id="page-header">
        <rect x="60" y="44" width="6" height="32" fill="{{ colors.primary }}"/>
        <text x="80" y="68" font-family="{{ typography.body_family }}" font-size="14" font-weight="600" fill="{{ colors.text_secondary }}" letter-spacing="3">对比分析</text>
        <text x="60" y="116" font-family="{{ typography.title_family }}" font-size="34" font-weight="700" fill="{{ colors.text }}">{{ title }}</text>
        {% if subtitle %}
        <text x="60" y="146" font-family="{{ typography.emphasis_family }}" font-size="18" font-style="italic" fill="{{ colors.text_secondary }}">{{ subtitle }}</text>
        {% endif %}
    </g>

    <!-- LEFT panel -->
    <g filter="url(#compCardShadow)">
        <rect x="60" y="180" width="560" height="460" rx="14" fill="{{ colors.bg }}" stroke="{{ colors.border }}" stroke-width="1"/>
        <rect x="60" y="180" width="560" height="8" rx="4" fill="{{ colors.primary }}"/>
        <circle cx="120" cy="230" r="28" fill="{{ colors.panel_blue }}"/>
        <text x="120" y="240" text-anchor="middle" font-family="{{ typography.emphasis_family }}" font-size="22" font-weight="800" fill="{{ colors.primary }}">A</text>
        <text x="164" y="224" font-family="{{ typography.body_family }}" font-size="24" font-weight="700" fill="{{ colors.text }}">{{ left_title or '方案 A' }}</text>
        <text x="164" y="252" font-family="{{ typography.emphasis_family }}" font-size="14" font-style="italic" fill="{{ colors.text_secondary }}">{{ left_subtitle or '' }}</text>

        <line x1="90" y1="280" x2="590" y2="280" stroke="{{ colors.border }}" stroke-width="1"/>

        {% for bullet in left_bullets or bullets %}
        {% if loop.index <= 4 %}
        {% set by = 308 + loop.index0 * 64 %}
        <circle cx="114" cy="{{ by + 6 }}" r="5" fill="{{ colors.primary }}"/>
        <text x="138" y="{{ by }}" font-family="{{ typography.body_family }}" font-size="18" font-weight="600" fill="{{ colors.text }}">{{ bullet.text }}</text>
        {% if bullet.sub %}
        <text x="138" y="{{ by + 24 }}" font-family="{{ typography.body_family }}" font-size="14" fill="{{ colors.text_secondary }}">{{ bullet.sub }}</text>
        {% endif %}
        {% endif %}
        {% endfor %}
    </g>

    <!-- VS badge -->
    <circle cx="640" cy="410" r="30" fill="{{ colors.accent }}"/>
    <text x="640" y="420" text-anchor="middle" font-family="{{ typography.emphasis_family }}" font-size="20" font-weight="800" fill="#FFFFFF">VS</text>

    <!-- RIGHT panel -->
    <g filter="url(#compCardShadow)">
        <rect x="660" y="180" width="560" height="460" rx="14" fill="{{ colors.bg }}" stroke="{{ colors.border }}" stroke-width="1"/>
        <rect x="660" y="180" width="560" height="8" rx="4" fill="{{ colors.accent }}"/>
        <circle cx="720" cy="230" r="28" fill="{{ colors.panel_yellow }}"/>
        <text x="720" y="240" text-anchor="middle" font-family="{{ typography.emphasis_family }}" font-size="22" font-weight="800" fill="{{ colors.accent }}">B</text>
        <text x="764" y="224" font-family="{{ typography.body_family }}" font-size="24" font-weight="700" fill="{{ colors.text }}">{{ right_title or '方案 B' }}</text>
        <text x="764" y="252" font-family="{{ typography.emphasis_family }}" font-size="14" font-style="italic" fill="{{ colors.text_secondary }}">{{ right_subtitle or '' }}</text>

        <line x1="690" y1="280" x2="1190" y2="280" stroke="{{ colors.border }}" stroke-width="1"/>

        {% for bullet in right_bullets or [] %}
        {% if loop.index <= 4 %}
        {% set by = 308 + loop.index0 * 64 %}
        <circle cx="714" cy="{{ by + 6 }}" r="5" fill="{{ colors.accent }}"/>
        <text x="738" y="{{ by }}" font-family="{{ typography.body_family }}" font-size="18" font-weight="600" fill="{{ colors.text }}">{{ bullet.text }}</text>
        {% if bullet.sub %}
        <text x="738" y="{{ by + 24 }}" font-family="{{ typography.body_family }}" font-size="14" fill="{{ colors.text_secondary }}">{{ bullet.sub }}</text>
        {% endif %}
        {% endif %}
        {% endfor %}
    </g>

    <text x="60" y="700" font-family="{{ typography.body_family }}" font-size="12" fill="{{ colors.text_secondary }}" letter-spacing="1">{{ deck_title }}　·　对比分析</text>
    <text x="1220" y="700" text-anchor="end" font-family="{{ typography.emphasis_family }}" font-size="12" fill="{{ colors.text_secondary }}" letter-spacing="2">{{ '%02d' % slide_id }} / {{ slide_count }}</text>
</svg>
