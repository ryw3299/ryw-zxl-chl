<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1280 720" width="1280" height="720">
    <defs>
        <linearGradient id="coverBg" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="{{ colors.primary }}"/>
            <stop offset="100%" stop-color="{{ colors.secondary_accent }}"/>
        </linearGradient>
        <radialGradient id="coverGlow" cx="85%" cy="20%" r="55%">
            <stop offset="0%" stop-color="{{ colors.accent }}" stop-opacity="0.22"/>
            <stop offset="100%" stop-color="{{ colors.accent }}" stop-opacity="0"/>
        </radialGradient>
        <linearGradient id="coverDeco" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="{{ colors.accent }}" stop-opacity="1"/>
            <stop offset="100%" stop-color="{{ colors.accent }}" stop-opacity="0"/>
        </linearGradient>
    </defs>

    <rect width="1280" height="720" fill="url(#coverBg)"/>
    <rect width="1280" height="720" fill="url(#coverGlow)"/>

    <g stroke="#FFFFFF" stroke-opacity="0.08" stroke-width="1">
        <line x1="0" y1="120" x2="1280" y2="120"/>
        <line x1="0" y1="600" x2="1280" y2="600"/>
        <line x1="120" y1="0" x2="120" y2="720"/>
        <line x1="1160" y1="0" x2="1160" y2="720"/>
    </g>

    <rect x="1100" y="60" width="120" height="6" fill="{{ colors.accent }}"/>
    <rect x="1140" y="76" width="80" height="6" fill="{{ colors.accent }}" fill-opacity="0.6"/>
    <rect x="1170" y="92" width="50" height="6" fill="{{ colors.accent }}" fill-opacity="0.3"/>

    <g id="course-tag">
        <rect x="120" y="200" width="220" height="42" rx="21" fill="#FFFFFF" fill-opacity="0.12" stroke="#FFFFFF" stroke-opacity="0.4" stroke-width="1.5"/>
        <text x="230" y="228" text-anchor="middle" font-family="{{ typography.body_family }}" font-size="18" font-weight="500" fill="#FFFFFF" fill-opacity="0.92">本科课程 · 课堂教学</text>
    </g>

    <text x="120" y="340" font-family="{{ typography.title_family }}" font-size="72" font-weight="800" fill="#FFFFFF" letter-spacing="2">{{ title }}</text>

    {% if subtitle %}
    <text x="120" y="406" font-family="{{ typography.body_family }}" font-size="44" font-weight="600" fill="{{ colors.accent }}">{{ subtitle }}</text>
    <rect x="120" y="438" width="280" height="4" fill="url(#coverDeco)"/>
    {% endif %}

    <text x="120" y="488" font-family="{{ typography.emphasis_family }}" font-size="22" font-style="italic" fill="#FFFFFF" fill-opacity="0.78">{{ english_subtitle or 'Courseware Presentation' }}</text>

    <g id="cover-meta">
        <rect x="120" y="592" width="4" height="48" fill="{{ colors.accent }}"/>
        <text x="138" y="616" font-family="{{ typography.body_family }}" font-size="14" font-weight="500" fill="#FFFFFF" fill-opacity="0.7">主讲</text>
        <text x="138" y="640" font-family="{{ typography.body_family }}" font-size="22" font-weight="700" fill="#FFFFFF">{{ instructor or '讲师' }}</text>

        <rect x="430" y="592" width="4" height="48" fill="{{ colors.accent }}"/>
        <text x="448" y="616" font-family="{{ typography.body_family }}" font-size="14" font-weight="500" fill="#FFFFFF" fill-opacity="0.7">面向</text>
        <text x="448" y="640" font-family="{{ typography.body_family }}" font-size="22" font-weight="700" fill="#FFFFFF">{{ audience or '本科生' }}</text>

        {% if chapter_info %}
        <rect x="660" y="592" width="4" height="48" fill="{{ colors.accent }}"/>
        <text x="678" y="616" font-family="{{ typography.body_family }}" font-size="14" font-weight="500" fill="#FFFFFF" fill-opacity="0.7">章节</text>
        <text x="678" y="640" font-family="{{ typography.body_family }}" font-size="22" font-weight="700" fill="#FFFFFF">{{ chapter_info }}</text>
        {% endif %}
    </g>

    <g transform="translate(120 144)">
        <rect x="0" y="0" width="56" height="56" rx="14" fill="#FFFFFF" fill-opacity="0.14"/>
        <use data-icon="tabler-filled/book" x="14" y="14" width="28" height="28" fill="{{ colors.accent }}"/>
    </g>

    <text x="1160" y="678" text-anchor="end" font-family="{{ typography.emphasis_family }}" font-size="14" fill="#FFFFFF" fill-opacity="0.5" letter-spacing="2">{{ '%02d' % slide_id }} / {{ slide_count }}</text>
</svg>
