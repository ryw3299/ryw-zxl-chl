<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1280 720" width="1280" height="720">
    <defs>
        <linearGradient id="chapBg" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="{{ colors.primary }}"/>
            <stop offset="100%" stop-color="#153E75"/>
        </linearGradient>
        <radialGradient id="chapGlow" cx="20%" cy="80%" r="60%">
            <stop offset="0%" stop-color="{{ colors.accent }}" stop-opacity="0.2"/>
            <stop offset="100%" stop-color="{{ colors.accent }}" stop-opacity="0"/>
        </radialGradient>
    </defs>

    <rect width="1280" height="720" fill="url(#chapBg)"/>
    <rect width="1280" height="720" fill="url(#chapGlow)"/>

    <g stroke="#FFFFFF" stroke-opacity="0.06" stroke-width="1">
        <line x1="0" y1="360" x2="1280" y2="360"/>
        <line x1="640" y1="0" x2="640" y2="720"/>
    </g>

    <rect x="60" y="60" width="80" height="4" fill="{{ colors.accent }}"/>
    <rect x="60" y="76" width="50" height="4" fill="{{ colors.accent }}" fill-opacity="0.6"/>

    <text x="120" y="280" font-family="{{ typography.emphasis_family }}" font-size="160" font-weight="800" fill="#FFFFFF" fill-opacity="0.08" letter-spacing="4">{{ chapter_number or '01' }}</text>

    <text x="120" y="320" font-family="{{ typography.body_family }}" font-size="18" font-weight="500" fill="{{ colors.accent }}" letter-spacing="4">CHAPTER {{ chapter_number or '01' }}</text>

    <text x="120" y="400" font-family="{{ typography.title_family }}" font-size="56" font-weight="700" fill="#FFFFFF">{{ title }}</text>

    {% if subtitle %}
    <text x="120" y="460" font-family="{{ typography.body_family }}" font-size="24" fill="#FFFFFF" fill-opacity="0.8">{{ subtitle }}</text>
    {% endif %}

    <rect x="120" y="500" width="200" height="3" fill="{{ colors.accent }}"/>

    {% if bullets %}
    <g id="chapter-preview">
        {% for bullet in bullets %}
        {% set py = 540 + loop.index0 * 36 %}
        <circle cx="136" cy="{{ py - 6 }}" r="4" fill="{{ colors.accent }}"/>
        <text x="156" y="{{ py }}" font-family="{{ typography.body_family }}" font-size="16" fill="#FFFFFF" fill-opacity="0.75">{{ bullet.text }}</text>
        {% endfor %}
    </g>
    {% endif %}

    <text x="1220" y="706" text-anchor="end" font-family="{{ typography.emphasis_family }}" font-size="14" fill="#FFFFFF" fill-opacity="0.4" letter-spacing="2">{{ '%02d' % slide_id }} / {{ slide_count }}</text>
</svg>
