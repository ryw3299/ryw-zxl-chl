<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1280 720" width="1280" height="720">
    <defs>
        <filter id="blockShadow" x="-10%" y="-10%" width="120%" height="120%">
            <feGaussianBlur in="SourceAlpha" stdDeviation="4"/>
            <feOffset dx="0" dy="2" result="offsetblur"/>
            <feFlood flood-color="#1F2937" flood-opacity="0.1" result="shadowColor"/>
            <feComposite in="shadowColor" in2="offsetblur" operator="in" result="shadow"/>
            <feMerge><feMergeNode in="shadow"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
    </defs>

    <rect width="1280" height="720" fill="{{ colors.bg }}"/>

    <g id="page-header">
        <rect x="60" y="44" width="6" height="32" fill="{{ colors.primary }}"/>
        <text x="80" y="68" font-family="{{ typography.body_family }}" font-size="14" font-weight="600" fill="{{ colors.text_secondary }}" letter-spacing="3">知识讲解</text>
        <text x="60" y="116" font-family="{{ typography.title_family }}" font-size="34" font-weight="700" fill="{{ colors.text }}">{{ title }}</text>
        {% if subtitle %}
        <text x="60" y="146" font-family="{{ typography.emphasis_family }}" font-size="18" font-style="italic" fill="{{ colors.text_secondary }}">{{ subtitle }}</text>
        {% endif %}
    </g>

    <g id="main-card">
        <rect x="60" y="180" width="1160" height="340" rx="14" fill="{{ colors.bg }}" stroke="{{ colors.border }}" stroke-width="1"/>
        <rect x="60" y="180" width="1160" height="8" rx="4" fill="{{ colors.primary }}"/>
        {% set content_x = 90 %}
        {% set content_w = 1100 %}
        {% if image_href %}
        {% set content_w = 640 %}
        {% endif %}

        {% if hook_text %}
        <rect x="{{ content_x }}" y="206" width="{{ content_w }}" height="46" rx="10" fill="{{ colors.info_bg }}"/>
        <text x="{{ content_x + 18 }}" y="235" font-family="{{ typography.body_family }}" font-size="15" font-weight="600" fill="{{ colors.primary }}">问题引入</text>
        <text x="{{ content_x + 110 }}" y="235" font-family="{{ typography.body_family }}" font-size="15" fill="{{ colors.text_secondary }}">{{ hook_text }}</text>
        {% endif %}

        {% set bullet_start_y = 286 if hook_text else 224 %}
        {% for bullet in bullets %}
        {% set by = bullet_start_y + loop.index0 * 42 %}
        <circle cx="{{ content_x + 10 }}" cy="{{ by + 6 }}" r="5" fill="{{ colors.accent }}"/>
        <text x="{{ content_x + 34 }}" y="{{ by }}" font-family="{{ typography.body_family }}" font-size="18" font-weight="600" fill="{{ colors.text }}">{{ bullet.text }}</text>
        {% if bullet.sub %}
        <text x="{{ content_x + 34 }}" y="{{ by + 22 }}" font-family="{{ typography.body_family }}" font-size="14" fill="{{ colors.text_secondary }}">{{ bullet.sub }}</text>
        {% endif %}
        {% endfor %}

        {% if side_notes %}
        {% set note_y = 410 %}
        {% for note in side_notes %}
        {% set ny = note_y + loop.index0 * 42 %}
        <rect x="{{ content_x }}" y="{{ ny - 18 }}" width="{{ content_w }}" height="32" rx="8" fill="{{ colors.panel_yellow if loop.index == 1 else colors.info_bg }}"/>
        <text x="{{ content_x + 16 }}" y="{{ ny + 2 }}" font-family="{{ typography.body_family }}" font-size="14" font-weight="700" fill="{{ colors.primary }}">{{ note.label }}</text>
        <text x="{{ content_x + 100 }}" y="{{ ny + 2 }}" font-family="{{ typography.body_family }}" font-size="14" fill="{{ colors.text_secondary }}">{{ note.text }}</text>
        {% endfor %}
        {% endif %}

        {% if image_href %}
        <g id="side-image">
            <rect x="800" y="214" width="380" height="240" rx="12" fill="{{ colors.info_bg }}" stroke="{{ colors.border }}" stroke-width="1"/>
            <image x="812" y="226" width="356" height="196" href="{{ image_href }}" preserveAspectRatio="xMidYMid meet"/>
            {% if image_caption %}
            <text x="990" y="444" text-anchor="middle" font-family="{{ typography.body_family }}" font-size="13" fill="{{ colors.text_secondary }}">{{ image_caption }}</text>
            {% endif %}
        </g>
        {% endif %}
    </g>

    {% if teaching_goal %}
    <g id="teaching-tip">
        <rect x="60" y="540" width="1160" height="50" rx="8" fill="{{ colors.info_bg }}"/>
        <rect x="60" y="540" width="6" height="50" rx="3" fill="{{ colors.primary }}"/>
        <text x="84" y="572" font-family="{{ typography.body_family }}" font-size="{{ typography.body }}" fill="{{ colors.text }}">
            <tspan font-weight="700" fill="{{ colors.primary }}">教学提示：</tspan>{{ teaching_goal }}
        </text>
    </g>
    {% endif %}

    <text x="60" y="700" font-family="{{ typography.body_family }}" font-size="12" fill="{{ colors.text_secondary }}" letter-spacing="1">{{ deck_title }}　·　知识讲解</text>
    <text x="1220" y="700" text-anchor="end" font-family="{{ typography.emphasis_family }}" font-size="12" fill="{{ colors.text_secondary }}" letter-spacing="2">{{ '%02d' % slide_id }} / {{ slide_count }}</text>
</svg>
